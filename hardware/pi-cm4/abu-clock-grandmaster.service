[Unit]
Description=Abu Clock Phase 3 Standalone Hardware PTP/gPTP/AbuSync Grandmaster Appliance
After=network-online.target systemd-modules-load.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/abu-clock/hardware/pi-cm4/init-ground-clock.sh
Restart=always
RestartSec=2
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80
IOSchedulingClass=realtime
IOSchedulingPriority=0
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_TIME CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_NICE

[Install]
WantedBy=multi-user.target
