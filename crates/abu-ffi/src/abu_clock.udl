namespace abu_clock {
    string get_version();
    u64 read_platform_monotonic_ns();
};

dictionary FfiTimecodeSnapshot {
    u8 hours;
    u8 minutes;
    u8 seconds;
    u8 frames;
    f64 subframe;
    boolean drop_frame;
    u32 bcd_u32;
    u64 tai_ns;
    u64 frame_index;
    f64 phase;
    string slate_text;
};

dictionary FfiCameraPose6DoF {
    u8 camera_id;
    f64 pan_deg;
    f64 tilt_deg;
    f64 roll_deg;
    f64 x_mm;
    f64 y_mm;
    f64 z_mm;
    u32 zoom_raw;
    u32 focus_raw;
};

dictionary FfiConvergenceMetrics {
    i64 offset_ns;
    f64 drift_ppb;
    u64 path_delay_ns;
    f64 warmup_progress;
    string lock_state;
};

interface AbuClockSdkEngine {
    constructor(u64 initial_tai_ns, u32 fps_num, u32 fps_den, boolean drop_frame);
    u64 now_tai_ns();
    u64 translate_monotonic_to_tai_ns(u64 host_mono_ns);
    FfiTimecodeSnapshot synthesize_timecode_at(u64 tai_ns);
    FfiTimecodeSnapshot wait_next_timestep_boundary();
    FfiConvergenceMetrics get_metrics();
    sequence<u8> pack_opentrackio_json(u16 sequence_id, FfiCameraPose6DoF pose);
    sequence<u8> pack_freed_d1(FfiCameraPose6DoF pose);
    sequence<u8> pack_freed_d2(FfiCameraPose6DoF pose);
};
